# Copy to .env (never commit .env). Mock mode needs nothing. For real models, see docs/MODELS.md.
PROVIDER_MODE=mock
OPENROUTER_API_KEY=
SPEAKER_A_MODEL=
SPEAKER_B_MODEL=
ARTIST_MODEL=
ALLOW_PAID_MODELS=false
MAX_REQUESTS_PER_DAY=40
MAX_TURNS_PER_RUN=8
MAX_OUTPUT_TOKENS_PER_TURN=1000
REQUEST_TIMEOUT_MS=60000

# Hosting only. Leave both unset on your own computer.
# HOST=0.0.0.0 makes CrossTalk reachable from other machines, and then ACCESS_CODE (8+ characters) is required.
# HOST=0.0.0.0
# ACCESS_CODE=

# Topic Scout (Milestone 7). Runs once a day at SCOUT_TIME, server time (set TZ, e.g. TZ=America/New_York).
# SCOUT_TIME=07:00
# Comma-separated RSS or Atom feeds to read, in addition to Hacker News and Wikipedia most-read.
# SCOUT_RSS_FEEDS=

# Control room lock when hosted (any mode). Optional; without it the Control room stays shut online.
# ADMIN_CODE=

# Keep episodes for good when hosted (optional, free). Litestream copies the database, including
# Iris's sketches, to a private S3-compatible bucket (e.g. Backblaze B2). Used by scripts/start.sh.
# BACKUP_BUCKET=
# BACKUP_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_REGION=us-west-004
# BACKUP_KEY_ID=
# BACKUP_SECRET=
